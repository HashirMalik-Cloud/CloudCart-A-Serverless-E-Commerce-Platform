# AWS & Amplify Configuration
NEXT_PUBLIC_AWS_REGION=us-east-1
PURCHASES_TABLE=Purchases
UPLOAD_BUCKET=cloudcart-private-assets

# Stripe Configuration (Public & Private Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# API Gateway Endpoint URLs
NEXT_PUBLIC_API_PURCHASES=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev/mypurchases
NEXT_PUBLIC_API_DOWNLOAD=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev/download
